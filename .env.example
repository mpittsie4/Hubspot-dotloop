# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Public base URL this server is reachable at (used to build OAuth redirect
# URIs and to register webhook target URLs). Must be HTTPS in production.
PUBLIC_BASE_URL=https://your-domain.example.com

# ---------------------------------------------------------------------------
# Database (Postgres). Schema is applied automatically on server start
# (see src/db/migrate.ts / migrations/001_init.sql) — no separate migrate
# step to remember.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://connector:connector@localhost:5432/connector

# ---------------------------------------------------------------------------
# HubSpot app (developers.hubspot.com -> your app -> Auth tab)
# ---------------------------------------------------------------------------
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_APP_ID=
# Comma-separated scopes your app needs. At minimum:
HUBSPOT_SCOPES=crm.objects.contacts.read,crm.objects.contacts.write,crm.objects.deals.read,crm.objects.deals.write,webhooks
# Redirect URI registered in the HubSpot app settings. Must exactly match.
HUBSPOT_REDIRECT_URI=${PUBLIC_BASE_URL}/auth/hubspot/callback
# Shared secret used to verify X-HubSpot-Signature-v3 on inbound webhooks.
# This is the app's client secret (HubSpot signs with the app secret).
HUBSPOT_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Dotloop app (register at https://dotloop.com/developers or via your
# Dotloop partner contact — see dotloop.github.io/public-api)
# ---------------------------------------------------------------------------
DOTLOOP_CLIENT_ID=
DOTLOOP_CLIENT_SECRET=
DOTLOOP_REDIRECT_URI=${PUBLIC_BASE_URL}/auth/dotloop/callback
# Filled in once you connect an account (see /auth/dotloop/callback logs),
# or looked up at runtime via GET /profile if you'd rather not hardcode it.
DOTLOOP_DEFAULT_PROFILE_ID=
# A secret YOU generate (e.g. `openssl rand -hex 32`) and pass as
# "signingKey" when creating the Dotloop subscription (see
# scripts/registerDotloopSubscriptions.ts). Dotloop echoes it back by
# signing each webhook body with it (HMAC-SHA1, X-DOTLOOP-SIGNATURE header)
# so we can verify inbound events came from Dotloop.
DOTLOOP_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Sync behavior
# ---------------------------------------------------------------------------
# Minutes between reconciliation polls (safety net in addition to webhooks).
RECONCILE_INTERVAL_MINUTES=15
# How far back (minutes) the very first reconciliation pass looks; after
# that it uses the stored high-water mark.
RECONCILE_INITIAL_LOOKBACK_MINUTES=1440
LOG_LEVEL=info
